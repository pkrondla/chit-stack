<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.1.0" />
  <PropertyGroup>
    <Name>ChitStack.Database.Tenant</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>{B2C3D4E5-6789-0123-4567-890123456789}</ProjectGuid>
  </PropertyGroup>
  <!-- Seeds + versioned migrations are not part of the initial schema model (RunOnce scripts are authoritative for new installs). -->
  <ItemGroup>
    <Build Remove="Seeds\**\*.sql" />
    <None Include="Seeds\**\*.sql" />
    <Build Remove="Versioned\**\*.sql" />
    <None Include="Versioned\**\*.sql" />
    <Build Remove="PostDeploy.sql" />
    <PostDeploy Include="PostDeploy.sql" />
  </ItemGroup>
  <!-- SQLCMD variables used in PostDeploy seed scripts.
       DefaultValue is used at build time only; the real value is passed via
       /v:TenantId=<n> when sqlpackage runs in the CI/CD pipeline. -->
  <ItemGroup>
    <SqlCmdVariable Include="TenantId">
      <DefaultValue>1</DefaultValue>
    </SqlCmdVariable>
  </ItemGroup>
</Project>
